{
  "configById": {
    "3D!rovi-scene": {
      "cameraState": {
        "distance": 16,
        "perspective": true,
        "phi": 55,
        "target": [0, 0, 0],
        "targetOffset": [0, 0, 0],
        "targetOrientation": [0, 0, 0, 1],
        "thetaOffset": 30,
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "followMode": "follow-pose",
      "followTf": "robot_00/odom",
      "scene": {},
      "transforms": {},
      "topics": {
        "/robot_00/odom": {
          "visible": true
        }
      },
      "layers": {
        "grid": {
          "visible": true,
          "layerId": "foxglove.Grid",
          "frameId": "robot_00/odom",
          "size": 20,
          "divisions": 20,
          "position": [0, 0, 0],
          "rotation": [0, 0, 0]
        }
      },
      "publish": {
        "type": "point"
      },
      "imageMode": {}
    },
    "StateTransitions!rovi-mode": {
      "paths": [
        {
          "value": "/rovi/robot_state{robot_id==0}.mode",
          "timestampMethod": "receiveTime",
          "label": "robot_00 mode (0 executing, 1 fallback)"
        }
      ],
      "isSynced": true
    },
    "Plot!rovi-buffer": {
      "paths": [
        {
          "value": "/rovi/robot_state{robot_id==0}.buffer_remaining_ns",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "robot_00 action buffer remaining (ns)"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp"
    },
    "Plot!rovi-slack": {
      "paths": [
        {
          "value": "/rovi/decisions{status==2}.reservation.slack_ns",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "admitted slack (ns)"
        },
        {
          "value": "/rovi/scheduler/cycles.runtime_ns",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "scheduler cycle runtime, host wall clock (ns)"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "isSynced": true,
      "xAxisVal": "timestamp"
    },
    "RawMessages!rovi-decisions": {
      "topicPath": "/rovi/decisions",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "RawMessages!rovi-metadata": {
      "topicPath": "/rovi/run_metadata",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "first": {
      "first": "3D!rovi-scene",
      "second": "StateTransitions!rovi-mode",
      "direction": "column",
      "splitPercentage": 72
    },
    "second": {
      "first": {
        "first": "Plot!rovi-buffer",
        "second": "Plot!rovi-slack",
        "direction": "column"
      },
      "second": {
        "first": "RawMessages!rovi-decisions",
        "second": "RawMessages!rovi-metadata",
        "direction": "column"
      },
      "direction": "row"
    },
    "direction": "row",
    "splitPercentage": 45
  }
}
