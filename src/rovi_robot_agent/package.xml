<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rovi_robot_agent</name>
  <version>0.1.0</version>
  <description>Robot agent with action-buffer deadlines, observation job generation, chunk validation, and local fallback state.</description>
  <maintainer email="130268324+Skywardbeta@users.noreply.github.com">Tony Chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rclcpp_components</depend>
  <depend>rovi_core</depend>
  <depend>rovi_interfaces</depend>
  <depend>rovi_telemetry</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
